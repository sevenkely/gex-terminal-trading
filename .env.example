# Identifiants Rithmic — copier en `.env` (jamais versionné, cf. .gitignore).
# Priorité : variables d'environnement > .env > data/rithmic_config.json.
#
# Gateway et système : ceux des exemples du dev kit R|Protocol
# (0.90.0.0/samples/samples.py/SampleMD.py). Ce host ne sert QUE le système
# « Rithmic Test » — vérifiable sans compte :
#     python backend/rithmic_client.py --systems
#     python backend/rithmic_client.py --gateways     # template 20
# « Rithmic Paper Trading » n'existe que sur rprotocol-ie / -de / -sg.

RITHMIC_USER=
RITHMIC_PASS=
RITHMIC_SYSTEM=Rithmic Test
RITHMIC_URL=wss://rituz00100.rithmic.com:443

# Optionnel
RITHMIC_APP_NAME=GexTerminal
RITHMIC_APP_VERSION=1.0
# RITHMIC_AUTO_CONNECT=true


# Administration Rithmic : verrouillée si vide. Générer localement un secret :
# python -c "import secrets; print(secrets.token_urlsafe(32))"
# Saisir sa valeur dans Paramètres > Jeton d'administration. Ne jamais le partager.
GEX_ADMIN_TOKEN=
# Simulation volontaire uniquement. Aucune panne du flux réel ne passe en SIM.
GEX_DEMO_MODE=false
# Même origine autorisée par défaut ; liste séparée par virgules pour CORS explicite.
GEX_ALLOWED_ORIGINS=
# Optionnel : noms d'hôtes Rithmic supplémentaires approuvés, sans protocole/port.
GEX_RITHMIC_HOSTS=

# Lecture privée facultative (API et WebSocket). Vide = lectures publiques.
# Jeton distinct de l'administration. L'UI crée une session HttpOnly d'une heure.
GEX_VIEWER_TOKEN=
# Production : hôtes autorisés séparés par virgules ; * uniquement en développement.
GEX_ALLOWED_HOSTS=*
# Enregistrement des ticks : opt-in, vérifier les droits de conservation du fournisseur.
# Rétention maximale 7 jours / 2 millions d'évènements (première limite atteinte).
GEX_RECORD_EVENTS=false
# Facultatif : fichier JSON de taux/rendements fourni par l'opérateur (voir docs).
GEX_MODEL_INPUTS=
# Facultatif : emplacement SQLite, utile pour activer une restauration vérifiée.
GEX_RESEARCH_DB=
# Ingestion d'observations options d'une source autorisée, désactivée si vide.
# Jeton séparé, nom exact du fournisseur et allowlist d'underlyings.
GEX_INGEST_TOKEN=
GEX_OPTION_FEED_SOURCE=
GEX_OPTION_FEED_SYMBOLS=
